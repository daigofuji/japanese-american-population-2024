# Copy to .env.local and fill in your values. Never commit .env.local.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# In CI: set as a GitHub Actions variable named VITE_GA_ID (Settings → Secrets and variables → Variables)
VITE_GA_ID=

# Census API key — get one free at api.census.gov/data/key_signup.html
# Used by: node scripts/fetch-data.mjs
CENSUS_API_KEY=


# Mapbox access token, Default public token
 — get one free at account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=